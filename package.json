{
  "name": "@overturo/js",
  "version": "1.3.0",
  "description": "JavaScript SDK for Overturo decisions — consent, approval, signing, and trust-surface flows",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build:schemas": "node scripts/compile-schemas.mjs",
    "build": "yarn build:schemas && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/measure-bundle.mjs"
  },
  "devDependencies": {
    "ajv": "^8.16.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "consent",
    "privacy",
    "sdk",
    "overturo",
    "approval",
    "decisions",
    "agent",
    "trust-surface"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overturo/js.git"
  },
  "homepage": "https://github.com/overturo/js#readme",
  "bugs": {
    "url": "https://github.com/overturo/js/issues"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/elements/**"
  ],
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "resolutions": {
    "esbuild": "^0.28.1"
  }
}
