{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.overturo.com/postmessage-v2/signature/state.json",
  "title": "signature STATE payload",
  "type": "object",
  "additionalProperties": true,
  "required": ["from", "to", "kind_payload"],
  "properties": {
    "from": { "type": ["string", "null"] },
    "to": {
      "type": "string",
      "enum": ["pending", "opened", "in_progress", "signed", "declined", "expired"]
    },
    "kind_payload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["required_assurance_level"],
      "properties": {
        "required_assurance_level": {
          "type": "string",
          "enum": ["integrity_proof", "advanced", "qualified"]
        },
        "participant_role": { "type": ["string", "null"] }
      }
    }
  }
}
