{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.overturo.com/postmessage-v2/consent/deadline.json",
  "title": "consent DEADLINE payload",
  "type": "object",
  "additionalProperties": true,
  "required": ["remaining_seconds", "level", "deadline_at"],
  "properties": {
    "remaining_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "level": {
      "type": "string",
      "enum": ["warning", "expired"]
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
