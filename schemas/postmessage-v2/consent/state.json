{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.overturo.com/postmessage-v2/consent/state.json",
  "title": "consent STATE payload",
  "type": "object",
  "additionalProperties": true,
  "required": ["from", "to", "step_index", "total_steps"],
  "properties": {
    "from": { "type": ["string", "null"] },
    "to": { "type": "string" },
    "step_index": { "type": "integer", "minimum": 0 },
    "total_steps": { "type": "integer", "minimum": 1 },
    "kind_payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
